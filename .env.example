BOT_TOKEN=your_telegram_bot_token_here
OPENAI_API_KEY=your_openai_api_key_here

# Set to "true" to disable audio output and force text-only responses
DISABLE_RECEIVE_AUDIO=false

# OpenAI model for translations (e.g., gpt-4.1-mini, gpt-5, gpt-5.1, gpt-5.4, gpt-5-mini)
OPENAI_MODEL=gpt-4.1-mini

# Set to "true" to use local Whisper instead of OpenAI Whisper API
USE_LOCAL_WHISPER=false

# URL to download the GGUF model file for local Whisper
WHISPER_MODEL_URL=https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3.bin
WHISPER_CPP_PATH=/workspaces/whisper.cpp/build/bin/whisper-cli
